# RAG 实战训练营 — 环境变量模板
# 复制到 .env 后按需修改；不要提交 .env

# ──────────────────────────────────────────────
# 后端选择
# ──────────────────────────────────────────────
# 通用 LLM：mmx (MiniMax-M3) | ollama
RAG_PROG_LLM_BACKEND=mmx
# Embedding：ollama | bge (本地 sentence-transformers)
RAG_PROG_EMBED_BACKEND=ollama

# ──────────────────────────────────────────────
# Ollama
# ──────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=60

# ──────────────────────────────────────────────
# mmx (MiniMax)
# ──────────────────────────────────────────────
MMX_BIN=/opt/homebrew/bin/mmx
MMX_MODEL=MiniMax-M3
MMX_REGION=global
MMX_TIMEOUT=60
MMX_MAX_TOKENS=2048
MMX_TEMPERATURE=0.0

# ──────────────────────────────────────────────
# BGE 本地（备选 Embedding）
# ──────────────────────────────────────────────
BGE_MODEL=BAAI/bge-small-en-v1.5
BGE_DIM=384
BGE_DEVICE=cpu

# ──────────────────────────────────────────────
# 检索
# ──────────────────────────────────────────────
CHUNK_SIZE=400
CHUNK_OVERLAP=60
TOP_K=8
RRF_K=60
RERANKER=heuristic     # identity | heuristic | cross-encoder
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CONTEXT_BUDGET_TOKENS=2400
PER_SOURCE_CAP=2

# ──────────────────────────────────────────────
# 数据
# ──────────────────────────────────────────────
DATA_DIR=./datasets/fixtures
GOLDEN_PATH=./datasets/golden/golden_v1.jsonl
REPORTS_DIR=./eval/reports

# ──────────────────────────────────────────────
# 课程关联
# ──────────────────────────────────────────────
KBCHAT_SRC=/Users/totallai/rag-course

# ──────────────────────────────────────────────
# S2 多租户 + S3 审计（ENTERPRISE_AUDIT S2 + S3）
# ──────────────────────────────────────────────
RAG_PROG_API_KEY=                              # 生产必设；空 = 鉴权 disabled
AUDIT_DIR=./data/audit
AUDIT_USER_ID_SALT=change-me-in-production     # HMAC salt；生产必设
AUDIT_RETENTION_DAYS=90

# ──────────────────────────────────────────────
# Postgres + pgvector（C5 容器化）
# ──────────────────────────────────────────────
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
P1_PG_DSN=postgresql://rag:rag@localhost:5432/rag
O6_PG_DSN=postgresql://rag:rag@localhost:5432/rag

# ──────────────────────────────────────────────
# Object Storage（S3 兼容；C5 用 minio）
# ──────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rag-ingest

# ──────────────────────────────────────────────
# OpenTelemetry（D6-T5 + C5）
# ──────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=rag-program

# ──────────────────────────────────────────────
# Prompt 防御（S4 — prompt injection 防御）
# ──────────────────────────────────────────────
RAG_PROG_MAX_QUERY_LEN=2000          # query 最大字符（超长 → fail-closed InputTooLongError）
RAG_PROG_GUARD_FAIL_CLOSED=true      # true=黑名单命中 block；false=warn+metric
