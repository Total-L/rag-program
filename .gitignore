# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Notebook
.ipynb_checkpoints/
*.ipynb_checkpoints/

# Env
.env
*.env.local

# Data (generated, can be rebuilt)
# NOTE: datasets/fixtures/ is NOT excluded — synthetic sample docs needed by
# P2/P4 smoke tests in CI (~1.2MB, no PII). F-6.2 CI gate fix 2026-07-30.
datasets/public/raw/
eval/reports/*/
!eval/reports/.gitkeep

# venv
.venv/
venv/

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# Traces (may contain sensitive data)
data/traces/
projects/*/data/audit/

# Vector index stores (rebuilt on demand; large + non-portable)
projects/*/data/index/*.sqlite3
projects/*/data/index/*.sqlite
projects/*/data/index/chroma.sqlite3
projects/*/chroma_db/*.sqlite3
projects/*/data/manifest.sqlite
